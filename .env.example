# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only — NEVER send to browser/agent

# ── Database (direct Postgres for SQLx in API server) ────────────────
DATABASE_URL=postgresql://postgres:[your-password]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── API Server ────────────────────────────────────────────────────────
API_PORT=8080
JWT_SECRET=your-supabase-jwt-secret   # copy from Supabase dashboard → Settings → API → JWT Secret
RUST_LOG=info,timeguard_api=debug

# ── Desktop Agent (stored in agent's local config file, NOT .env) ────
# AGENT_API_URL=http://localhost:8080/api/v1
# DEVICE_TOKEN=<uuid issued by tenant admin per employee>
